library(caret)
library(randomForest)
library(glmnet)
library(xgboost)
library(tidyverse)
library(e1071)
# Load dataset
data <- read.csv("nonMedical_columns.csv")
# Define target variable (assuming last column is the target)
target_var <- names(data)[ncol(data)]
x <- data[, -ncol(data)]
y <- data[[target_var]]
# Step 1: Feature Selection
# Recursive Feature Elimination (RFE)
control <- rfeControl(functions = rfFuncs, method = "cv", number = 5)
rfe_result <- rfe(x, y, sizes = c(12), rfeControl = control)
Top12_RFE <- predictors(rfe_result)
write.csv(Top12_RFE, "Top12_RFE_Features.csv", row.names = FALSE)
# Lasso Regression
lasso_model <- cv.glmnet(as.matrix(x), y, alpha = 1)
lasso_coef <- coef(lasso_model, s = "lambda.min")
Top12_Lasso <- rownames(lasso_coef)[order(abs(lasso_coef[,1]), decreasing = TRUE)[2:13]]
write.csv(Top12_Lasso, "Top12_Lasso_Features.csv", row.names = FALSE)
# Random Forest Feature Importance
rf_model <- randomForest(x, y, importance = TRUE)
Top12_RF <- names(sort(rf_model$importance[,1], decreasing = TRUE))[1:12]
write.csv(Top12_RF, "Top12_RF_Features.csv", row.names = FALSE)
# Step 2: Model Training & Evaluation
models <- list("XGBoost" = xgboost, "RandomForest" = randomForest, "LogisticRegression" = glm)
feature_sets <- list("RFE" = Top12_RFE, "Lasso" = Top12_Lasso, "RF" = Top12_RF)
results <- data.frame()
for (fs_name in names(feature_sets)) {
selected_features <- feature_sets[[fs_name]]
x_selected <- x[, selected_features]
train_index <- createDataPartition(y, p = 0.8, list = FALSE)
x_train <- x_selected[train_index, ]
y_train <- y[train_index]
x_test <- x_selected[-train_index, ]
y_test <- y[-train_index]
for (model_name in names(models)) {
if (model_name == "XGBoost") {
model <- xgboost(data = as.matrix(x_train), label = y_train, nrounds = 50, objective = "binary:logistic", verbose = 0)
preds <- predict(model, as.matrix(x_test))
preds <- ifelse(preds > 0.5, 1, 0)
} else if (model_name == "RandomForest") {
model <- randomForest(x_train, y_train)
preds <- predict(model, x_test)
} else if (model_name == "LogisticRegression") {
model <- glm(y_train ~ ., data = data.frame(x_train, y_train), family = binomial)
preds <- ifelse(predict(model, data.frame(x_test), type = "response") > 0.5, 1, 0)
}
cm <- confusionMatrix(as.factor(preds), as.factor(y_test))
result_row <- data.frame(Feature_Set = fs_name, Model = model_name,
Accuracy = cm$overall["Accuracy"],
Precision = cm$byClass["Precision"],
Recall = cm$byClass["Recall"],
F1_Score = cm$byClass["F1"])
results <- rbind(results, result_row)
}
}
