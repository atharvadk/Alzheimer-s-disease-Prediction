source("~/.active-rstudio-document")
# Load selected feature datasets
rfe_data <- read.csv("Top12_RFE_Features.csv")
lasso_data <- read.csv("Top12_Lasso_Features.csv")
rf_data <- read.csv("Top12_RF_Features.csv")
# Extract feature names (excluding Diagnosis column)
rfe_features <- colnames(rfe_data)[colnames(rfe_data) != "Diagnosis"]
lasso_features <- colnames(lasso_data)[colnames(lasso_data) != "Diagnosis"]
rf_features <- colnames(rf_data)[colnames(rf_data) != "Diagnosis"]
# Find common and unique features
common_features <- Reduce(intersect, list(rfe_features, lasso_features, rf_features))  # Features in all three
unique_rfe <- setdiff(rfe_features, c(lasso_features, rf_features))
unique_lasso <- setdiff(lasso_features, c(rfe_features, rf_features))
unique_rf <- setdiff(rf_features, c(rfe_features, lasso_features))
# Print results
print("✅ Features Selected by All 3 Methods:")
print(common_features)
print("🔹 Features Unique to RFE:")
print(unique_rfe)
print("🔹 Features Unique to Lasso:")
print(unique_lasso)
print("🔹 Features Unique to Random Forest:")
print(unique_rf)
install.packages("VennDiagram")
library(VennDiagram)
# Create a Venn diagram
venn.plot <- draw.triple.venn(
area1 = length(rfe_features),
area2 = length(lasso_features),
area3 = length(rf_features),
n12 = length(intersect(rfe_features, lasso_features)),
n13 = length(intersect(rfe_features, rf_features)),
n23 = length(intersect(lasso_features, rf_features)),
n123 = length(common_features),
category = c("RFE", "Lasso", "Random Forest"),
fill = c("blue", "red", "green"),
alpha = 0.5,
cex = 1.5
)
# Save the plot
png("Feature_Selection_Venn.png")
grid.draw(venn.plot)
dev.off()
# Combine all selected features
all_features <- c(rfe_features, lasso_features, rf_features)
# Count occurrences of each feature
feature_counts <- table(all_features)
# Convert to dataframe and sort by frequency
feature_counts_df <- as.data.frame(feature_counts)
feature_counts_df <- feature_counts_df[order(-feature_counts_df$Freq), ]
# Save results
write.csv(feature_counts_df, "Feature_Frequency.csv", row.names=FALSE)
print("✅ Features ranked by frequency saved to Feature_Frequency.csv")
print(feature_counts_df)
source("~/.active-rstudio-document")
