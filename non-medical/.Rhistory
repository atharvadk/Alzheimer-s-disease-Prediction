# Load necessary libraries
library(tidyverse)
library(caret)
library(randomForest)
library(glmnet)
# Load dataset
df <- read.csv("nonMedical_columns.csv")
# Convert categorical variables to factors
df <- df %>%
mutate(across(where(is.character), as.factor))
# Separate features and target variable
target <- "Diagnosis"
X <- df %>% select(-Diagnosis)
y <- df$Diagnosis
# Convert categorical variables to numeric (One-Hot Encoding)
X <- model.matrix(~ . - 1, data = X)
# Standardize numeric features
X_scaled <- scale(X)
# Train/Test Split (80-20)
set.seed(42)
trainIndex <- createDataPartition(y, p = 0.8, list = FALSE)
X_train <- X_scaled[trainIndex, ]
y_train <- y[trainIndex]
# ---- 1️⃣ Recursive Feature Elimination (RFE) ----
ctrl_rfe <- rfeControl(functions = rfFuncs, method = "cv", number = 5)  # 5-fold cross-validation
rfe_model <- rfe(X_train, y_train, sizes = c(5, 10, 15), rfeControl = ctrl_rfe)
# **FIX: Properly Save RFE Rankings**
rfe_ranking_df <- data.frame(
Feature = colnames(X),
RFE_Rank = rfe_model$fit$ranking  # Get full ranking for all features
)
# Load necessary library
library(dplyr)
# Read the CSV file
input_file <- "nonMedical_columns.csv"  # Change this to your input file path
data <- read.csv(input_file, stringsAsFactors = FALSE)
# Select specific columns (modify as needed)
selected_columns <- data %>% select(BehavioralProblems, EducationLevel, MemoryComplaints, SleepQuality, Smoking, AlcoholConsumption, DietQuality, Ethnicity, PhysicalActivity)  # Change column names
# Write the selected columns to a new CSV file
output_file <- "overlaped_features.csv"  # Change this to your desired output file path
write.csv(selected_columns, output_file, row.names = FALSE)
print("Selected columns have been saved to output.csv")
